.venv/
.env
__pycache__/
*.pyc
data/*.json
data/competition_profiles.json
data/corpus_profiles.json
data/cache/
data/*.csv.gz
data/*.csv.gz.part
data/*.log
data/*.err
data/*.pid
data/_*


# Packaging build metadata, regenerated by pip/setuptools on every build.
# Tracking it would commit CRLF-terminated generated files and create
# diff noise on any tooling version bump.
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/

# Generated by --html-output during any run.
report/

# Delivered corpora are tracked despite the data/*.json rule above:
# the submission requires the profiles to be present in the repository,
# and the 100-company smoke-test report is part of the submission.
!data/registry_1000.json
!data/corpus_profiles.json
!data/smoke_100_report.json
