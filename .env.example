# Copy to .env and fill in. Every key is optional: the agent runs without
# any of them and says plainly in `retrieval_errors` what it could not do.
#
#   cp .env.example .env
#
# Real environment variables always win over this file, so CI and
# container runs can inject credentials without it. Point SIGNALPOST_ENV_FILE
# elsewhere to keep keys outside the working tree.

# --- Free, no account required -------------------------------------------

# Brreg (the Norwegian registry) needs nothing. It is the authoritative
# source for names, legal form, status, industry, addresses, directors and
# filed accounts, and it backs the registry spine of every profile.

# --- Optional, free tier --------------------------------------------------

# Extraction and narrative model. An NVIDIA API key unlocks the Nemotron
# endpoint at no charge, rate-limited rather than billed.
# Without it the agent still returns every registry field; it simply cannot
# extract web facts or write a narrative.
NVIDIA_API_KEY=

# --- Optional, billable ----------------------------------------------------

# The only billable external API this agent calls. It is used solely to
# discover candidate pages for a company. Without it the agent falls back
# to crawling the registered website directly, which covers a narrower set
# of companies but still returns the full registry spine.
#
# Declared per run: roughly 200 calls for 100 companies. No other external
# API is called, so no other cost is incurred.
TINYFISH_API_KEY=

# --- Execution limits -----------------------------------------------------

# The competition ceiling is 2,000 outbound requests per 100-company run.
# The agent degrades coverage rather than exceeding it: it reads fewer pages
# per company as the budget drains, and past a floor returns the registry
# spine alone, recording why in `retrieval_errors`.
AGENT_REQUEST_LIMIT=2000

# Timeouts. The defaults suit a scored run; a bulk corpus build can trade
# patience for throughput.
AGENT_HTTP_TIMEOUT=20
AGENT_HTTP_ATTEMPTS=2